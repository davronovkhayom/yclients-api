{
  "name": "yclients-api",
  "version": "0.1.0",
  "description": "Typed, zero-dependency TypeScript client for the YCLIENTS REST API (api.yclients.ru) with pagination and rate-limit retries.",
  "keywords": [
    "yclients",
    "api",
    "client",
    "sdk",
    "typescript",
    "booking",
    "crm"
  ],
  "license": "MIT",
  "author": "davronovkhayom (https://github.com/davronovkhayom)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davronovkhayom/yclients-api.git"
  },
  "homepage": "https://github.com/davronovkhayom/yclients-api#readme",
  "bugs": {
    "url": "https://github.com/davronovkhayom/yclients-api/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
